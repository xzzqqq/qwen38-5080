# 模型权重：体积大，不入库
models/
# 队列 / worktree 里 models 和 .venv 是**符号链接**，`models/`（目录形式）匹配不到，
# 会被 git 当成 untracked，使 op 产物的 provenance.dirty 变成 true。按名忽略。
/models
/.venv
*.gguf

# 第三方工具 checkout：用 scripts/setup_llama_cpp.sh 按固定 commit 拉取
llama.cpp/

# 临时文件
.tmp/

# 实验队列产物（request/execution/summary/logs/output，可能很大）
results/experiments/

# 运行时日志
logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编译产物
build/
*.o
*.a
*.so
*.cubin
*.fatbin

# 编辑器 / 工具缓存
.vscode/
.idea/
.cache/
